rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('email', '') == 'jaikladigital@gmail.com' ||
        request.auth.token.get('email', '') == 'admin@jaikladigital.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    // Function to check if user is staff (or admin)
    function isStaffOrAdmin() {
      return request.auth != null && (
        isAdmin() ||
        (request.auth.token.get('email', '') != '' && request.auth.token.get('email', '').matches('.*@jaikladigital[.]com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'staff')
      );
    }

    match /config/{document=**} {
      // Anyone can read config to load the event name, date, etc.
      allow read: if true;
      // Only admin can update config
      allow write: if isAdmin();
    }

    match /tables/{tableId} {
      // Anyone can read tables to see what's available
      allow read: if true;
      allow create: if isStaffOrAdmin();
      allow update: if true;
      allow delete: if isStaffOrAdmin();
    }

    match /tickets/{ticketId} {
      // Anyone can read a ticket initially, maybe we can restrict reading later if needed, but for now allow to check QR etc.
      allow read: if true; 
      // Anyone can create a ticket by purchasing
      allow create: if true;
      // Only staff or admin can update (like check-in)
      allow update: if isStaffOrAdmin();
      // Only admin can delete
      allow delete: if isAdmin();
    }

    match /surveys/{surveyId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /luckyDraw/{luckyDrawId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /users/{userId} {
      // Users can get their own role, admins can read and list all
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    match /help_requests/{requestId} {
      allow create: if isStaffOrAdmin();
      allow read, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }
    
    match /staff_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    match /booths/{boothId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    match /boothScanLogs/{logId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }
  }
}
