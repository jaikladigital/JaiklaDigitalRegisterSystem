# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for Resend email API calls.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM_EMAIL: The actual verified email address from your Resend domain.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# GMAIL_SMTP_USER: Your Gmail Address (for fallback email sending via Gmail SMTP)
GMAIL_SMTP_USER="your-email@gmail.com"

# GMAIL_SMTP_PASSWORD: Your Gmail App Password (NOT your login password)
GMAIL_SMTP_PASSWORD="xxxx xxxx xxxx xxxx"

# LINE Notifications
# LINE_NOTIFY_TOKEN="your_line_notify_token_here"
# LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"

# Twilio SMS
# TWILIO_ACCOUNT_SID="your_twilio_account_sid"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_FROM_NUMBER="+1234567890"
